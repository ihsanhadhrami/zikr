{
  "name": "zikir",
  "compatibility_date": "2026-08-01",
  // Small Worker that serves ./public and makes link-preview URLs absolute.
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only HTML pages go through the Worker; images, scripts etc. are served directly.
    "run_worker_first": ["/", "/index.html"]
  }
}
